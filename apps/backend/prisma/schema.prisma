generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  SYSTEM
}

enum CallKind {
  AUDIO
  VIDEO
}

enum CallStatus {
  MISSED
  DECLINED
  ENDED
  BUSY
}

model User {
  id           BigInt    @id @default(autoincrement())
  email        String    @unique(map: "uq_users_email") @db.VarChar(255)
  username     String    @unique(map: "uq_users_username") @db.VarChar(32)
  displayName  String    @map("display_name") @db.VarChar(64)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(512)
  bio          String?   @db.VarChar(280)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  lastSeenAt   DateTime? @map("last_seen_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  ownedConversations Conversation[]       @relation("ConversationOwner")
  memberships        ConversationMember[]
  messages           Message[]
  reactions          Reaction[]
  refreshTokens      RefreshToken[]
  callsPlaced        CallLog[]

  @@map("users")
}

model Conversation {
  id      BigInt           @id @default(autoincrement())
  type    ConversationType
  name    String?          @db.VarChar(100)
  avatarUrl String?        @map("avatar_url") @db.VarChar(512)
  ownerId BigInt?          @map("owner_id")

  directKey String? @unique(map: "uq_conversations_direct_key") @map("direct_key") @db.VarChar(40)

  lastMessageId BigInt?  @map("last_message_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  owner       User?                @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lastMessage Message?             @relation("ConversationLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  members     ConversationMember[]
  messages    Message[]            @relation("ConversationMessages")
  calls       CallLog[]

  @@index([ownerId], map: "idx_conversations_owner")
  @@index([lastMessageId], map: "idx_conversations_last_message")
  @@map("conversations")
}

model ConversationMember {
  conversationId BigInt     @map("conversation_id")
  userId         BigInt     @map("user_id")
  role           MemberRole @default(MEMBER)

  lastReadMessageId BigInt    @default(0) @map("last_read_message_id")
  mutedUntil        DateTime? @map("muted_until") @db.DateTime(3)
  joinedAt          DateTime  @default(now()) @map("joined_at") @db.DateTime(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId], map: "idx_members_user")
  @@map("conversation_members")
}

model Message {
  id             BigInt      @id @default(autoincrement())
  conversationId BigInt      @map("conversation_id")
  senderId       BigInt      @map("sender_id")
  type           MessageType @default(TEXT)
  body           String?     @db.Text
  replyToId      BigInt?     @map("reply_to_id")

  clientMsgId String @unique(map: "uq_messages_client_id") @map("client_msg_id") @db.Char(36)

  editedAt  DateTime? @map("edited_at") @db.DateTime(3)

  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  conversation Conversation  @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]     @relation("MessageReplies")
  attachments  Attachment[]
  reactions    Reaction[]
  pointedAtBy  Conversation[] @relation("ConversationLastMessage")

  @@index([conversationId, id(sort: Desc)], map: "idx_messages_conv")
  @@index([senderId], map: "idx_messages_sender")
  @@index([replyToId], map: "idx_messages_reply_to")
  @@fulltext([body], map: "ft_messages_body")
  @@map("messages")
}

model Attachment {
  id         BigInt  @id @default(autoincrement())
  messageId  BigInt  @map("message_id")
  objectKey  String  @map("object_key") @db.VarChar(512)
  thumbKey   String? @map("thumb_key") @db.VarChar(512)
  mime       String  @db.VarChar(127)
  size       Int     @db.UnsignedInt
  width      Int?    @db.UnsignedInt
  height     Int?    @db.UnsignedInt
  durationMs Int?    @map("duration_ms") @db.UnsignedInt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "idx_attachments_message")
  @@map("attachments")
}

model Reaction {
  messageId BigInt   @map("message_id")
  userId    BigInt   @map("user_id")
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([userId], map: "idx_reactions_user")
  @@map("reactions")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")

  tokenHash String    @unique(map: "uq_refresh_tokens_hash") @map("token_hash") @db.Char(64)

  familyId  String    @map("family_id") @db.Char(36)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user")
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@index([expiresAt], map: "idx_refresh_tokens_expires")
  @@map("refresh_tokens")
}

model CallLog {
  id             BigInt     @id @default(autoincrement())
  callId         String     @unique(map: "uq_call_logs_call_id") @map("call_id") @db.Char(36)
  conversationId BigInt     @map("conversation_id")
  callerId       BigInt     @map("caller_id")
  kind           CallKind
  status         CallStatus
  startedAt      DateTime   @default(now()) @map("started_at") @db.DateTime(3)
  endedAt        DateTime?  @map("ended_at") @db.DateTime(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller       User         @relation(fields: [callerId], references: [id], onDelete: Cascade)

  @@index([conversationId, startedAt(sort: Desc)], map: "idx_call_logs_conv")
  @@index([callerId], map: "idx_call_logs_caller")
  @@map("call_logs")
}
