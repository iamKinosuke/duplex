NODE_ENV=development
PORT=4100
LOG_LEVEL=debug

DATABASE_URL=mysql://duplex:duplex@localhost:3306/duplex

REDIS_URL=redis://localhost:6379
REDIS_PREFIX=duplex:

FRONTEND_ORIGIN=http://localhost:3000

JWT_SECRET=change-me-to-at-least-32-characters-long-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

TRUST_PROXY=loopback

RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=300000
RATE_LIMIT_MESSAGE_MAX=30
RATE_LIMIT_MESSAGE_WINDOW_MS=10000
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_REFRESH_WINDOW_MS=300000
RATE_LIMIT_PROFILE_MAX=20
RATE_LIMIT_PROFILE_WINDOW_MS=60000
